# Copy to .env.local in apps/web and apps/mobile. Never commit the real values.

# Supabase — from your project dashboard, Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# The site URL used to build invite links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Invite emails (apps/web only, server side; never prefix with NEXT_PUBLIC_).
# Use the organisation's own mailbox, the same one set as Supabase Auth's
# custom SMTP, so verification and invite emails come from one address.
# Leave empty locally: invites still work, and the owner copies the link.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=invites@example.com
SMTP_PASSWORD=
EMAIL_FROM="Alarsio <invites@example.com>"

# NEVER put the service-role key here or anywhere in this repo.
