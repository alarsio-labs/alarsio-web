{
  "expo": {
    "name": "Alarsio",
    "slug": "alarsio",
    "scheme": "alarsio",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "in.alarsio.app",
      "adaptiveIcon": {
        "backgroundColor": "#241A12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.VIBRATE"
      ],
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Alarsio reads your location once, when you tap Check in or Check out, to record that you are at the site. It does not track you in the background."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Alarsio opens the camera when you tap Take photo, to add a photo to your daily report.",
          "photosPermission": "Alarsio opens your photos when you tap Choose photo, to add one to your daily report.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#241A12",
          "imageWidth": 200
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "./plugins/with-arm-only.js"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a664e60b-1d02-457d-b65b-8f7ff30d75dd"
      }
    },
    "owner": "alarsio"
  }
}
